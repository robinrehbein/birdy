  "placeholderSubstitution": {
    "formula": "s.replace(/\\{(\\w+)\\}/g, (_, k) => values[k] ?? '')",
    "example_rewardAd_n3": "▶ Watch an ad · +30 coins (3/3 today)",
    "example_missingValue_becomesEmptyString": "▶ Watch an ad · +30 coins (/3 today)",
    "example_multiPlaceholder_streak": "[fire] Streak: day 5 · tomorrow +60"
  },
  "setLangUnknownIsNoOp": {
    "afterSetLangFr": "en"
  },
  "setLangDe": {
    "getLang": "de"
  },
  "fallbackRule": {
    "formula": "STRINGS[lang][key] ?? STRINGS.de[key] ?? key",
    "unknownKeyReturnsKeyItself": "___doesNotExist___"
  },
  "L_helper": {
    "formula": "L(v) = (v && typeof v === \"object\") ? (v[lang] ?? v.de) : v",
    "example_object_de": "Hallo",
    "example_object_en": "Hello",
    "example_plainString": "unchanged",
    "example_missingLangFallsBackToDe": "NurDeutsch"
  },
  "detectFormula": {
    "rule1": "if localStorage.getItem(\"birdy-lang\") is \"de\" or \"en\", use it",
    "rule2": "else: navigator.language.toLowerCase().startsWith(\"de\") ? \"de\" : \"en\"",
    "storageKey": "birdy-lang"
  }
